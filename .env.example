# Copy this file to `.env` and change the values. Never commit `.env` to the repository.

# Postgres (docker compose). In local development the app connects through port 5434.
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://admin_funca:change-this-password@localhost:5434/admin_funca?schema=public

# Secret used to sign sessions (JWT). Generate a long random one:  openssl rand -base64 48
AUTH_SECRET=change-this-secret-to-a-long-random-string

# Independent key to encrypt personal data (document, phone) in the database. Must differ from
# AUTH_SECRET. If it is lost, that data cannot be recovered:  openssl rand -base64 48
DATA_KEY=change-this-key-to-a-long-random-string

# Port where the app is exposed on the VPS (optional, 3020 by default).
APP_PORT=3020

# Public URL of the platform (for links in emails). E.g. https://admin.funca.edu.co
APP_URL=

# Outgoing email (appointment request confirmation and time notice). nodemailer format:
# smtp://user:password@server:587  ·  smtps://user:password@server:465
# Without SMTP_URL, in development emails are printed to the server console.
SMTP_URL=
MAIL_FROM="FUNCA Bienestar <no-responder@funca.edu.co>"

# Institutional email domains accepted by the public appointment link (comma separated).
MAIL_DOMAINS=funca.edu.co

# Password of the first admin created by the seed in production:
#   docker compose run --rm migrate node_modules/.bin/tsx prisma/seed.ts
SEED_ADMIN_PASSWORD=

# Daily database backups (backup service): days to keep and hour of the day (00-23).
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=02
